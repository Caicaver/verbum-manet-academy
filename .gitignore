# ════════════════════════════════════════════════════════════════════════
#  Verbum Manet Academy — .gitignore
# ════════════════════════════════════════════════════════════════════════

# ─── Sistema operativo ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.AppleDouble
.LSOverride

# ─── Editores e IDEs ────────────────────────────────────────────────────
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.netrwhist

# ─── Python (herramienta vma_audit) ─────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/

# ─── Node (futuras herramientas) ────────────────────────────────────────
node_modules/
package-lock.json
yarn.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Backups y temporales del auditor ───────────────────────────────────
*.bak
*.orig
*.tmp
*.log

# ─── Reportes de auditoría (no se versionan) ────────────────────────────
audit-reports/
audit-reports-*/
audit-tool/
*.audit.json

# ─── Builds y caches ────────────────────────────────────────────────────
dist/
build/
.cache/
.parcel-cache/

# ─── Cloudflare Wrangler ────────────────────────────────────────────────
.wrangler/
wrangler.toml.bak

# ─── Secretos (jamás versionar) ─────────────────────────────────────────
.env
.env.local
.env.*.local
secrets.json
*.pem
*.key

# ─── Archivos específicos del proyecto ──────────────────────────────────
# Borradores y scratchpad personal (mantener fuera del repo)
borrador/
scratch/
notas-personales/
*.draft.md
*.draft.html

# ─── Excepciones: estos sí se versionan ─────────────────────────────────
!.gitignore
!.gitattributes
!.editorconfig
!_headers
!_redirects
