# ============================================================================
# Verbum Manet Academy · _redirects
# Reglas de routing para Cloudflare Pages
# ============================================================================
#
# Sintaxis: <fuente> <destino> <código>
#   200 → rewrite (URL no cambia, contenido del destino)
#   301 → redirect permanente (URL cambia)
#   302 → redirect temporal
#   "!" al final del código fuerza la redirección incluso si existe el archivo
#
# La arquitectura usa HASH ROUTING (#/curso): el cliente resuelve las rutas.
# Estas reglas cubren los casos en que el usuario llegue por una URL canónica
# o variante.
# ============================================================================


# ─────────────────────────────────────────────────────────────────
# Forzar HTTPS (Cloudflare ya lo hace, pero se deja explícito)
# ─────────────────────────────────────────────────────────────────
http://verbum-manet.pages.dev/*  https://verbum-manet.pages.dev/:splat  301


# ─────────────────────────────────────────────────────────────────
# Canonicalización: www → no-www (recomendación SEO)
# Si configura un dominio personalizado, descomente y ajuste:
# ─────────────────────────────────────────────────────────────────
# https://www.verbummanet.org/*   https://verbummanet.org/:splat   301!


# ─────────────────────────────────────────────────────────────────
# Aliases legibles que redirigen a las rutas hash del SPA
# Permiten URLs limpias compartibles que el router resolverá
# ─────────────────────────────────────────────────────────────────
/inicio              /#/                              302
/home                /#/                              302
/cursos              /#/courses                       302
/courses             /#/courses                       302
/curricula           /#/courses                       302
/curriculum          /#/courses                       302
/glosario            /#/glossary                      302
/glossary            /#/glossary                      302
/acerca              /#/about                         302
/about               /#/about                         302
/sobre               /#/about                         302


